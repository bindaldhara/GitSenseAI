APP_NAME=GitSense AI
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=FRONTEND_URL


POSTGRES_DB=DB_NAME
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_HOST=HOST
POSTGRES_PORT=PORT

REDIS_URL=REDIS-URL
QDRANT_URL=QDRANT_URL
REPOSITORY_CLONE_DIR=CLONE_PATH

# LLM — default is local Ollama (no API key). Set LLM_PROVIDER=openai + OPENAI_API_KEY for OpenAI.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
