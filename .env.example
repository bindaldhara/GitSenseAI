APP_NAME=GitSense AI
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=FRONTEND_URL


POSTGRES_DB=DB_NAME
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_HOST=HOST
POSTGRES_PORT=PORT
# Required for Supabase Postgres (omit for local Homebrew/Docker)
POSTGRES_SSLMODE=

REDIS_URL=REDIS-URL
QDRANT_URL=QDRANT_URL
QDRANT_API_KEY=
REPOSITORY_CLONE_DIR=CLONE_PATH

# LLM — local Ollama, OpenAI, or OpenRouter (OpenAI-compatible).
# OpenRouter: LLM_PROVIDER=openai, OPENAI_BASE_URL=https://openrouter.ai/api/v1,
# OPENAI_API_KEY=sk-or-v1-..., OPENAI_MODEL=<id ending in :free>
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Hybrid search 
BM25_INDEX_DIR=data/bm25_indices
HYBRID_SEARCH_ENABLED=true
HYBRID_RRF_K=60
HYBRID_CANDIDATE_MULTIPLIER=4

# Cross-encoder reranking (ONNX via FastEmbed — no PyTorch)
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Semantic cache (Redis) — reuse answers for similar single-turn questions
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.50
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_MAX_ENTRIES_PER_REPO=100

# LangGraph multi-agent chat 
AGENTS_ENABLED=true

# Graph RAG — symbol/file graph in Postgres
GRAPH_RAG_ENABLED=true

# Supabase Auth (frontend uses VITE_*; backend verifies Supabase JWTs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Auth, chat history, multi-repo scoping
AUTH_ENABLED=true
ADMIN_EMAIL=admin@gmail.com
